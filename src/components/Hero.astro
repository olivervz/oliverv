---
import MailIcon from "./icons/MailIcon.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedinIcon from "./icons/LinkedinIcon.astro";

// Update these once — email/social links live in one place.
const EMAIL = "you@example.com"; // TODO: replace with your real email
const GITHUB_URL = "https://github.com/olivervz";
const LINKEDIN_URL = "https://www.linkedin.com/in/YOUR-HANDLE"; // TODO: replace
---

<section class="hero">
  <div class="hero-content">
    <p class="eyebrow">Hi, my name is</p>
    <h1>Oliver Vazquez</h1>
    <p class="bio">
      I'm a New York City&ndash;based software engineer working at Salesforce.
    </p>

    <nav class="nav-links">
      <a href="/work">Work</a>
      <a href="/photos">Photos</a>
      <a href="/documents/Resume.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
    </nav>
  </div>

  <div class="social-row">
    <a href={`mailto:${EMAIL}`} aria-label="Email">
      <MailIcon size={17} />
    </a>
    <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
      <GithubIcon size={17} />
    </a>
    <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
      <LinkedinIcon size={17} />
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-content {
    width: 100%;
    max-width: 700px;
    /* centered within the viewport by the flex parent, then nudged left
       of dead-center with asymmetric margin instead of text-align, so the
       block still reads left-aligned rather than centered */
    margin-right: clamp(24px, 9vw, 130px);
  }

  .hero-content h1 {
    font-size: clamp(56px, 8.5vw, 92px);
    line-height: 1.02;
    /* optical correction: the round "O" overshoots the left edge of
       flat-sided letters (H, I, W) above/below it */
    margin: 10px 0 0 6px;
  }

  .bio {
    font-size: 18px;
    line-height: 1.6;
    opacity: 0.72;
    max-width: 460px;
    margin: 18px 0 0 0;
  }

  .nav-links {
    display: flex;
    gap: 32px;
    margin-top: 24px;
    font-weight: 600;
    font-size: 15px;
  }

  .social-row {
    position: absolute;
    left: var(--gutter);
    bottom: clamp(32px, 6vw, 56px);
  }
</style>
