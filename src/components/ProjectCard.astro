---
import GithubIcon from "./icons/GithubIcon.astro";
import ExternalLinkIcon from "./icons/ExternalLinkIcon.astro";
import type { Project } from "../data/projects";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card">
  <h3>{project.title}</h3>
  <p class="description">{project.description}</p>
  <div class="tags">
    {project.tech.map((t) => <span class="tag">{t}</span>)}
  </div>
  <div class="links">
    <a href={project.githubUrl} class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label={`${project.title} on GitHub`}>
      <GithubIcon size={15} />
    </a>
    {project.liveUrl && (
      <a href={project.liveUrl} class="icon-btn" target="_blank" rel="noopener noreferrer" aria-label={`${project.title} live link`}>
        <ExternalLinkIcon size={15} />
      </a>
    )}
  </div>
</article>

<style>
  .card {
    /* a slight tint off the page background so cards read as distinct
       surfaces instead of blending into it; derived from the theme vars
       so it stays correct in both light and dark mode */
    background: color-mix(in srgb, var(--ink) 6%, var(--bg));
    border: 1px solid var(--ink);
    padding: 22px 22px 18px 22px;
  }

  .card h3 {
    font-size: 18px;
  }

  .description {
    font-size: 15px;
    line-height: 1.5;
    opacity: 0.72;
    margin: 8px 0 12px 0;
    min-height: 4.5em;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tag {
    font-size: 12.5px;
    font-weight: 500;
    letter-spacing: 0.3px;
    padding: 4px 10px;
    border: 1px solid var(--ink);
    opacity: 0.65;
  }

  .links {
    display: flex;
    gap: 8px;
    margin-top: 14px;
  }

  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--ink);
  }
</style>
