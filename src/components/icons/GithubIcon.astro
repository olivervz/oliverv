---
interface Props {
  size?: number;
}
const { size = 17 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <polyline points="9 8 4 12 9 16"></polyline>
  <polyline points="15 8 20 12 15 16"></polyline>
</svg>
