  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <rect x="4" y="4" width="16" height="16" rx="3"></rect>
  <line x1="8" y1="10" x2="8" y2="16"></line>
  <circle cx="8" cy="7" r="0.6" fill="currentColor"></circle>
  <path d="M12 16v-4c0-1.4 1-2 2-2s2 0.6 2 2v4"></path>
</svg>
