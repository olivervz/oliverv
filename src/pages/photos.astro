---
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import { photos } from "../data/photos";

const cameras = [...new Set(photos.map((p) => p.camera))].sort();
const films = [...new Set(photos.map((p) => p.film))].sort();
const locations = [...new Set(photos.map((p) => p.location))].sort();

const MONTH_NAMES = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];

// initial server render: newest first, grouped by year, then by month
// within each year. Ties (same YYYY-MM) break on `batch` — the order
// rolls were tagged in, most-recently-tagged first to match "newest" —
// so two different rolls shot the same month stay as two contiguous
// clusters instead of interleaving.
const sorted = [...photos].sort(
  (a, b) => b.date.localeCompare(a.date) || Number(b.batch) - Number(a.batch)
);
type MonthGroup = { month: string; items: typeof sorted };
type YearGroup = { year: string; months: MonthGroup[] };
const groups: YearGroup[] = [];
for (const p of sorted) {
  const year = p.date.slice(0, 4);
  const month = p.date.length >= 7 ? p.date.slice(5, 7) : "";
  let yearGroup = groups[groups.length - 1];
  if (!yearGroup || yearGroup.year !== year) {
    yearGroup = { year, months: [] };
    groups.push(yearGroup);
  }
  let monthGroup = yearGroup.months[yearGroup.months.length - 1];
  if (!monthGroup || monthGroup.month !== month) {
    monthGroup = { month, items: [] };
    yearGroup.months.push(monthGroup);
  }
  monthGroup.items.push(p);
}
---

<Layout title="Photos — Oliver Vazquez" description="Photo log.">
  <SiteNav current="photos" />

  <section class="photos-page">
    <header>
      <h1>Photos</h1>
      <p class="subhead">Mostly pictures of my friends, things I like, or other stuff</p>
    </header>

    <div class="controls">
      <div class="filters">
        <div class="select-field" data-filter="camera">
          <button type="button" class="field-trigger" aria-haspopup="listbox" aria-expanded="false">
            <span class="label">Camera</span>
            <span class="field-value">All</span>
            <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1l4 4 4-4"></path></svg>
          </button>
          <ul class="field-menu" role="listbox" hidden>
            <li role="option" data-value="" aria-selected="true">All</li>
            {cameras.map((c) => <li role="option" data-value={c} aria-selected="false">{c}</li>)}
          </ul>
        </div>
        <div class="select-field" data-filter="film">
          <button type="button" class="field-trigger" aria-haspopup="listbox" aria-expanded="false">
            <span class="label">Film</span>
            <span class="field-value">All</span>
            <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1l4 4 4-4"></path></svg>
          </button>
          <ul class="field-menu" role="listbox" hidden>
            <li role="option" data-value="" aria-selected="true">All</li>
            {films.map((f) => <li role="option" data-value={f} aria-selected="false">{f}</li>)}
          </ul>
        </div>
        <div class="select-field" data-filter="location">
          <button type="button" class="field-trigger" aria-haspopup="listbox" aria-expanded="false">
            <span class="label">Location</span>
            <span class="field-value">All</span>
            <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 1l4 4 4-4"></path></svg>
          </button>
          <ul class="field-menu" role="listbox" hidden>
            <li role="option" data-value="" aria-selected="true">All</li>
            {locations.map((l) => <li role="option" data-value={l} aria-selected="false">{l}</li>)}
          </ul>
        </div>
      </div>

      <div class="sort-controls">
        <button id="shuffle-btn" class="shuffle-btn" type="button" aria-label="Shuffle" title="Shuffle">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="16 3 21 3 21 8"></polyline>
            <line x1="4" y1="20" x2="21" y2="3"></line>
            <polyline points="21 16 21 21 16 21"></polyline>
            <line x1="15" y1="15" x2="21" y2="21"></line>
            <line x1="4" y1="4" x2="9" y2="9"></line>
          </svg>
        </button>
        <div class="sort-toggle" role="group" aria-label="Sort order">
          <button id="sort-oldest" type="button">Oldest first</button>
          <button id="sort-newest" class="active" type="button">Newest first</button>
        </div>
      </div>
    </div>

    <div id="photo-grid" class="photo-grid">
      {groups.length === 0 && (
        <p class="empty-state">
          No photos yet — run <code>npm run tag-photos</code> to add some.
        </p>
      )}
      {groups.map((g) => (
        <div class="year-block" data-year={g.year}>
          <div class="year-row">
            <span class="num">{g.year}</span>
            <span class="line"></span>
          </div>
          {g.months.map((m) => (
            <>
              {m.month && (
                <p class="month-label">{MONTH_NAMES[parseInt(m.month, 10) - 1] ?? m.month}</p>
              )}
              <div class="tile-grid">
                {m.items.map((p) => (
                  <button
                    type="button"
                    class={`tile${p.image ? "" : " tile-color"}${p.width && p.height && p.height > p.width ? " tile-portrait" : ""}`}
                    style={p.image ? undefined : `background:${p.color}`}
                    data-id={p.id}
                    aria-label={`${p.location}, ${p.date}`}
                  >
                    {p.image && <img src={p.image} alt="" loading="lazy" />}
                  </button>
                ))}
              </div>
            </>
          ))}
        </div>
      ))}
    </div>

    <p class="hint">click a photo to see camera, film, location &amp; notes</p>
  </section>

  <div id="lightbox" class="lightbox" hidden>
    <button id="lightbox-close" class="lightbox-close" aria-label="Close" type="button">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4l16 16M20 4L4 20"></path></svg>
    </button>
    <div class="lightbox-content">
      <div id="lightbox-image" class="lightbox-image"></div>
      <div class="lightbox-caption">
        <div id="lightbox-location" class="lightbox-location"></div>
        <div id="lightbox-meta" class="lightbox-meta"></div>
        <div id="lightbox-notes" class="lightbox-notes"></div>
      </div>
    </div>
  </div>

  <script
    type="application/json"
    id="photos-data"
    set:html={JSON.stringify(photos).replace(/</g, "\\u003c")}
  />
</Layout>

<style is:global>
  /* global: the tile/year-block markup below is partly rebuilt client-side
     (see the script block below) via plain document.createElement calls, which
     never receive Astro's scoped-style data-astro-cid attribute — so these
     rules have to be unscoped or the JS-rebuilt tiles silently lose all
     their sizing/layout CSS and collapse to native button size. */
  .photos-page {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: clamp(24px, 5vw, 40px) var(--gutter) 40px;
  }

  header h1 {
    font-size: clamp(30px, 4vw, 42px);
    margin-top: 10px;
  }

  .subhead {
    font-size: 15px;
    opacity: 0.65;
    margin-top: 12px;
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 32px;
  }

  .filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* custom dropdown replacing the native <select>. This wrapper is
     purely a positioning context for the menu below — it deliberately
     does NOT also carry the site-wide .field pill styling (border,
     padding, background), only .field-trigger does. Applying .field to
     both this wrapper and the trigger button inside it was the previous
     bug: two nested boxes each drawing their own border/padding reads
     as one thick double-outlined pill instead of one. The native
     dropdown *panel* that used to open under it was unstyleable OS
     chrome (grey on most platforms, ignores our theme entirely), so
     this is a real, from-scratch listbox instead. */
  .select-field {
    position: relative;
  }

  .field-trigger {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid var(--ink);
    font: inherit;
    font-weight: 500;
    font-size: 14px;
    color: inherit;
    background: transparent;
    cursor: pointer;
  }

  .field-trigger:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .field-trigger:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* the wrapping .select-field div carries no border/padding of its own
     (see the comment above it) — this replaces the site-wide .field
     .label rule that used to style this span via the wrapper, which no
     longer applies now that the wrapper isn't a .field. */
  .field-trigger .label {
    opacity: 0.55;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .field-value {
    font-weight: 500;
  }

  .chevron {
    flex-shrink: 0;
    opacity: 0.6;
    transition: transform 0.2s ease;
  }

  .select-field.open .chevron {
    transform: rotate(180deg);
  }

  .field-menu {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 10;
    min-width: 100%;
    max-height: 260px;
    overflow-y: auto;
    margin: 0;
    padding: 4px;
    list-style: none;
    background: var(--bg);
    border: 1px solid var(--ink);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
  }

  .field-menu li {
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
    cursor: pointer;
  }

  .field-menu li:hover {
    background: color-mix(in srgb, var(--ink) 8%, transparent);
  }

  .field-menu li[aria-selected="true"] {
    background: var(--ink);
    color: var(--bg);
  }

  .sort-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .shuffle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border: 1px solid var(--ink);
    background: transparent;
    color: var(--ink);
    opacity: 0.55;
    cursor: pointer;
    transition: opacity 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  .shuffle-btn:hover {
    opacity: 0.85;
  }

  .shuffle-btn.active {
    background: var(--ink);
    color: var(--bg);
    opacity: 1;
  }

  /* momentary click feedback, distinct from .active's persistent "we're
     in shuffle mode" color — this one is only ever on for 2s (see the
     click handler below) and eases back off via the site-wide
     background-color/color transition already defined near the top of
     this file, no separate transition needed here */
  .shuffle-btn.flash {
    background: var(--accent);
    color: var(--bg);
    opacity: 1;
  }

  /* spins the icon on every press — the repeatable motion is what signals
     "this can be pressed again for another shuffle", not just a one-shot
     toggle switching on */
  @keyframes shuffle-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .shuffle-btn svg {
    transform: rotate(0deg);
  }

  .shuffle-btn.spin svg {
    animation: shuffle-spin 0.5s ease;
  }

  .sort-toggle {
    display: inline-flex;
    border: 1px solid var(--ink);
  }

  .sort-toggle button {
    font-weight: 600;
    font-size: 13px;
    padding: 9px 16px;
    border: none;
    background: transparent;
    color: var(--ink);
    opacity: 0.55;
    cursor: pointer;
    font-family: var(--font);
  }

  .sort-toggle button.active {
    background: var(--ink);
    color: var(--bg);
    opacity: 1;
  }

  .year-block {
    margin-top: 34px;
  }

  .year-block:first-child {
    margin-top: 28px;
  }

  .year-row {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
  }

  .year-row .num {
    font-family: var(--font);
    font-weight: 700;
    font-size: 20px;
    opacity: 0.85;
    white-space: nowrap;
  }

  .year-row .line {
    flex: 1;
    height: 1px;
    background: var(--ink);
    opacity: 0.25;
  }

  .month-label {
    font-family: var(--font);
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.6px;
    text-transform: uppercase;
    opacity: 0.4;
    margin: 22px 0 10px;
  }

  .year-row + .month-label {
    margin-top: 0;
  }

  /* establishes the container-query context .tile-grid uses just below
     to size its rows off its own on-screen width, with no JS resize
     listener needed — safe to query against since none of
     .photo-grid's descendants (.year-block, .tile-grid) add horizontal
     padding of their own, so its inline size always exactly matches
     .tile-grid's own width. */
  .photo-grid {
    container-type: inline-size;
  }

  /* Fixed grid: always 3 columns (2 on narrow phones, see the media
     query below) — every tile is exactly one column wide, and a
     landscape tile is exactly one row tall; a portrait tile spans two
     rows (see .tile-portrait below), so it reads as one landscape-width
     tile that's exactly two landscape-heights + the gap between them
     tall, per spec. Row height is a container query length (cqw), not
     JS, so this stays correct at any viewport size / column count with
     no resize listener at all — nothing needs recomputing when, say,
     the mobile address bar shows/hides mid-scroll. */
  .tile-grid {
    --cols: 3;
    --gap: 14px;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: var(--gap);
    /* landscape (3:2) tile height at the current column width:
       colWidth * 2/3, where colWidth = (100cqw - gaps) / cols */
    grid-auto-rows: calc((100cqw - (var(--cols) - 1) * var(--gap)) / var(--cols) * 2 / 3);
  }

  @media (max-width: 700px) {
    .tile-grid {
      --cols: 2;
    }
  }

  /* shuffle mode skips the year-block/year-row/month-label entirely (one
     flat grid, no dividers), which otherwise contribute ~90px of space
     above the first row of tiles (28px year-block top margin + ~40px
     year-row + ~24px month-label) — add it back here so toggling shuffle
     doesn't yank the grid upward. */
  .shuffle-grid {
    margin-top: 90px;
  }

  .tile {
    display: block;
    width: 100%;
    height: 100%;
    border: none;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    transition: transform 0.2s ease, opacity 0.4s ease;
  }

  /* every tile fills its grid cell exactly (see .tile-grid's
     grid-auto-rows above) — object-fit: cover keeps an ordinary
     landscape photo's own crop looking natural within that cell. */
  .tile img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* spans two rows (see .tile-grid's grid-auto-rows above), so it reads
     as one landscape-width tile that's two landscape-heights + the row
     gap tall. That box's aspect ratio won't generally match the photo's
     own, so this stretches the image to fill it rather than cropping —
     full photo over a cropped one, with slight distortion as the
     explicitly-accepted tradeoff. */
  .tile-portrait {
    grid-row: span 2;
  }

  .tile-portrait img {
    object-fit: fill;
  }

  .tile:hover {
    transform: scale(1.02);
    /* tiles are absolutely positioned edge-to-edge by JS (no grid gap
       cushion between them anymore), so a hover-scaled tile needs to sit
       above its neighbors or the zoom clips against them */
    z-index: 2;
  }

  .hint {
    font-size: 13px;
    opacity: 0.45;
    margin-top: 36px;
  }

  .empty-state {
    font-size: 14px;
    opacity: 0.5;
    padding: 40px 0;
  }

  .empty-state code {
    font-family: monospace;
    background: color-mix(in srgb, var(--ink) 8%, transparent);
    padding: 2px 6px;
  }

  /* lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px;
    /* deliberately NOT var(--ink) — in dark mode that variable flips to
       the light cream color, which would make this backdrop light
       instead of dark. A photo lightbox should stay dark regardless of
       site theme, so this is a fixed near-black. */
    background: rgba(8, 10, 10, 0.92);
    backdrop-filter: blur(11px);
    /* without this, a touch-drag meant as a left/right swipe (handled by
       our own JS below) also gets read by the browser as a page pan,
       which is what caused the clunky vertical wobble/rubber-banding
       while swiping between photos on mobile. This tells the browser to
       leave all panning here to us. Body scroll is also locked in JS
       while the lightbox is open, as a second guard against the same
       thing. */
    touch-action: none;
  }

  .lightbox[hidden] {
    display: none;
  }

  /* Everything below is deliberately fixed light-on-dark, not themed off
     --ink/--bg — the backdrop is always near-black now (see .lightbox
     above), so the chrome sitting on top of it has to stay legible in
     both site themes rather than flipping with them. */

  .lightbox-close {
    position: absolute;
    right: 32px;
    top: 32px;
    width: 38px;
    height: 38px;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .lightbox-close:hover {
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }

  /* sized to hug the photo's own dimensions (never cropped), while
     staying within the viewport: the image gets as much of that space
     as it can, the caption takes whatever's left below it. */
  .lightbox-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 94vw;
    max-height: 92vh;
    animation: lightbox-in 0.22s ease;
  }

  @keyframes lightbox-in {
    from {
      opacity: 0;
      transform: scale(0.97) translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* a thin, faint rim gives the photo an edge against the near-black
     backdrop (otherwise dark areas of the image would bleed straight
     into it), and the layered shadow underneath is what makes it read
     as sitting above the backdrop rather than flat against it */
  .lightbox-image {
    flex: 1 1 auto;
    min-height: 0;
    max-width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.09),
      0 10px 20px rgba(0, 0, 0, 0.4),
      0 30px 70px rgba(0, 0, 0, 0.55);
  }

  /* max-height: 100% here would be a percentage of this element's own
     height, which is never a fixed value (it's sized by flexing to fit
     its content) — so browsers just ignore it and let the image render
     at full natural size. That's what was cutting photos off at the top
     in landscape: a wide, short-viewport photo would render taller than
     the screen with nothing capping it. Capping against the viewport
     height directly (vh) instead of a percentage fixes that regardless
     of orientation. */
  .lightbox-image img {
    display: block;
    max-width: 100%;
    max-height: min(70vh, calc(92vh - 96px));
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* legacy color-only placeholder rows have no real image to size
     against, so they still need an explicit box */
  .lightbox-image.color-fallback {
    flex: 0 0 auto;
    width: min(100%, 480px);
    aspect-ratio: 4 / 5;
  }

  /* no card, no box — just text sitting directly on the backdrop, so it
     reads as part of the same dark surface instead of a bolted-on bar */
  .lightbox-caption {
    flex: 0 0 auto;
    width: 100%;
    max-width: 520px;
    margin-top: 20px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    text-align: center;
  }

  .lightbox-location {
    font-family: var(--font);
    font-weight: 600;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.92);
  }

  .lightbox-meta {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.3px;
    margin-top: 5px;
  }

  .lightbox-notes {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.65);
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .lightbox-notes:empty {
    display: none;
  }

  /* on narrow phones (portrait) and short viewports (landscape phones —
     caught by max-height, since a landscape phone is plenty wide) the
     caption was reading way too large relative to the available space,
     crowding out the photo itself */
  @media (max-width: 700px), (max-height: 500px) {
    .lightbox-caption {
      margin-top: 12px;
      padding-top: 10px;
    }

    .lightbox-location {
      font-size: 14px;
    }

    .lightbox-meta {
      font-size: 11px;
    }

    .lightbox-notes {
      font-size: 12px;
      margin-top: 8px;
      padding-top: 8px;
    }
  }
</style>

<script>
  type Photo = {
    id: string;
    date: string;
    batch: string;
    title: string;
    camera: string;
    film: string;
    location: string;
    notes: string;
    image?: string;
    width?: number;
    height?: number;
    color?: string;
  };

  const dataEl = document.getElementById("photos-data");
  const photos: Photo[] = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];

  const grid = document.getElementById("photo-grid")!;
  const sortOldestBtn = document.getElementById("sort-oldest")!;
  const sortNewestBtn = document.getElementById("sort-newest")!;
  const shuffleBtn = document.getElementById("shuffle-btn")!;

  let sortDir: "oldest" | "newest" | "shuffle" = "newest";

  // Fisher-Yates — doesn't mutate the input
  function shuffleArray<T>(arr: T[]): T[] {
    const a = [...arr];
    for (let i = a.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [a[i], a[j]] = [a[j], a[i]];
    }
    return a;
  }

  // the currently visible (filtered + sorted) photos, in display order —
  // kept in sync by render() so the lightbox can step through them with
  // the arrow keys/swipe regardless of what filters/sort are active.
  // Justified-row layout (see buildTileGrid) fills strictly in this same
  // order, row by row, left to right, so this doubles as visual reading
  // order too — no separate bookkeeping needed to keep the two in sync.
  let visiblePhotos: Photo[] = [];
  let currentIndex = -1;

  // ---------- custom filter dropdowns ----------
  //
  // Replaces the native <select> elements: the closed "pill" look was
  // fine with plain CSS, but the *open* dropdown panel is OS-native
  // chrome that ignores page styling almost everywhere (the "boring
  // grey"), so this is a small from-scratch listbox instead — a button
  // that toggles a styled <ul role="listbox"> underneath it.

  const FILTER_KEYS = ["camera", "film", "location"] as const;
  type FilterKey = (typeof FILTER_KEYS)[number];

  const filterState: Record<FilterKey, string> = { camera: "", film: "", location: "" };
  const filterFields: Record<FilterKey, HTMLElement> = {
    camera: document.querySelector('[data-filter="camera"]')!,
    film: document.querySelector('[data-filter="film"]')!,
    location: document.querySelector('[data-filter="location"]')!,
  };

  function matchesFilters(p: Photo): boolean {
    return (
      (!filterState.camera || p.camera === filterState.camera) &&
      (!filterState.film || p.film === filterState.film) &&
      (!filterState.location || p.location === filterState.location)
    );
  }

  function syncFieldDisplay(key: FilterKey) {
    const field = filterFields[key];
    const value = filterState[key];
    field.querySelector(".field-value")!.textContent = value || "All";
    field.querySelectorAll("[role='option']").forEach((li) => {
      li.setAttribute("aria-selected", String((li as HTMLElement).dataset.value === value));
    });
  }

  function closeAllMenus() {
    for (const key of FILTER_KEYS) {
      const field = filterFields[key];
      field.classList.remove("open");
      field.querySelector(".field-trigger")!.setAttribute("aria-expanded", "false");
      (field.querySelector(".field-menu") as HTMLElement).hidden = true;
    }
  }

  function selectFilterValue(key: FilterKey, value: string) {
    filterState[key] = value;

    // the filter the user just touched is their explicit new intent —
    // if combining it with whatever else is currently set would leave
    // nothing to show, drop every *other* active filter instead of
    // showing an empty grid. Every value in these dropdowns comes from
    // an actual photo, so filtering on just this one key alone can
    // never itself be empty.
    if (value !== "" && !photos.some(matchesFilters)) {
      for (const otherKey of FILTER_KEYS) {
        if (otherKey !== key) filterState[otherKey] = "";
      }
    }

    for (const k of FILTER_KEYS) syncFieldDisplay(k);
    closeAllMenus();
    render();
  }

  for (const key of FILTER_KEYS) {
    const field = filterFields[key];
    const trigger = field.querySelector(".field-trigger") as HTMLButtonElement;
    const menu = field.querySelector(".field-menu") as HTMLElement;

    trigger.addEventListener("click", () => {
      const wasOpen = !menu.hidden;
      closeAllMenus();
      if (!wasOpen) {
        field.classList.add("open");
        trigger.setAttribute("aria-expanded", "true");
        menu.hidden = false;
      }
    });

    menu.addEventListener("click", (e) => {
      const li = (e.target as HTMLElement).closest("[role='option']") as HTMLElement | null;
      if (li) selectFilterValue(key, li.dataset.value ?? "");
    });
  }

  document.addEventListener("click", (e) => {
    const target = e.target as Node;
    if (!FILTER_KEYS.some((k) => filterFields[k].contains(target))) closeAllMenus();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeAllMenus();
  });

  const MONTHS = [
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December",
  ];

  function formatDate(date: string): string {
    const [y, m] = date.split("-");
    if (m) {
      const idx = parseInt(m, 10) - 1;
      return `${MONTHS[idx] ?? m} ${y}`;
    }
    return y;
  }

  // ---------- tile grid ----------
  //
  // Layout itself is pure CSS now (see .tile-grid / .tile-portrait in
  // the stylesheet above): a fixed grid, always 3 columns (2 on narrow
  // phones), sized off the grid's own on-screen width via a container
  // query length. All this needs to do is create each tile in order and
  // flag the ones that need to span two rows.

  function isPortrait(photo: Photo): boolean {
    // every real (image-backed) photo has stored dimensions as of this
    // build; missing dimensions (or a legacy color-only placeholder)
    // fall back to "not portrait" rather than guessing
    return !!(photo.width && photo.height && photo.height > photo.width);
  }

  // builds one <div class="tile-grid"> of photo buttons inside
  // `container`. Fills strictly in `items`' own order — CSS grid's
  // default (non-dense) auto-placement never reorders items behind ones
  // already placed, so DOM order already matches on-screen reading
  // order with no separate bookkeeping needed for lightbox nav.
  function buildTileGrid(container: HTMLDivElement, items: Photo[]): void {
    for (const photo of items) {
      const btn = document.createElement("button");
      btn.type = "button";
      btn.className = photo.image ? "tile" : "tile tile-color";
      if (isPortrait(photo)) btn.classList.add("tile-portrait");
      if (photo.image) {
        const img = document.createElement("img");
        img.src = photo.image;
        img.alt = "";
        img.loading = "lazy";
        btn.appendChild(img);
      } else {
        btn.style.background = photo.color ?? "";
      }
      btn.dataset.id = photo.id;
      btn.setAttribute("aria-label", `${photo.location}, ${photo.date}`);
      btn.addEventListener("click", () => openLightbox(photo));
      container.appendChild(btn);
    }
  }

  function render() {
    let filtered = photos.filter(matchesFilters);

    if (sortDir === "shuffle") {
      filtered = shuffleArray(filtered);
    } else {
      // ties (same YYYY-MM) break on batch — the order rolls were tagged
      // in — so two rolls shot the same month stay as two contiguous
      // clusters instead of interleaving photo-by-photo
      filtered.sort((a, b) => {
        const dateCmp =
          sortDir === "oldest" ? a.date.localeCompare(b.date) : b.date.localeCompare(a.date);
        if (dateCmp !== 0) return dateCmp;
        const batchCmp = Number(a.batch) - Number(b.batch);
        return sortDir === "oldest" ? batchCmp : -batchCmp;
      });
    }
    grid.innerHTML = "";

    if (filtered.length === 0) {
      const empty = document.createElement("p");
      empty.className = "empty-state";
      empty.textContent =
        photos.length === 0
          ? "No photos yet — run npm run tag-photos to add some."
          : "No photos match these filters.";
      grid.appendChild(empty);
      visiblePhotos = [];
    } else if (sortDir === "shuffle") {
      // shuffled order doesn't get year/month dividers — randomly
      // interspersed one-photo groups would be more confusing than
      // useful, so it's just one flat, ungrouped grid instead. It gets
      // the .shuffle-grid class so CSS can add back the top space the
      // (skipped) year/month header would otherwise have taken.
      const tileGrid = document.createElement("div");
      tileGrid.className = "tile-grid shuffle-grid";
      // append before building — buildTileGrid measures clientWidth,
      // which only reads real once the element is attached to the DOM
      grid.appendChild(tileGrid);
      buildTileGrid(tileGrid, filtered);
      visiblePhotos = filtered;
    } else {
      type MonthGroup = { month: string; items: Photo[] };
      type YearGroup = { year: string; months: MonthGroup[] };
      const groups: YearGroup[] = [];
      for (const p of filtered) {
        const year = p.date.slice(0, 4);
        const month = p.date.length >= 7 ? p.date.slice(5, 7) : "";
        let yearGroup = groups[groups.length - 1];
        if (!yearGroup || yearGroup.year !== year) {
          yearGroup = { year, months: [] };
          groups.push(yearGroup);
        }
        let monthGroup = yearGroup.months[yearGroup.months.length - 1];
        if (!monthGroup || monthGroup.month !== month) {
          monthGroup = { month, items: [] };
          yearGroup.months.push(monthGroup);
        }
        monthGroup.items.push(p);
      }

      for (const g of groups) {
        const block = document.createElement("div");
        block.className = "year-block";
        block.dataset.year = g.year;

        const row = document.createElement("div");
        row.className = "year-row";
        row.innerHTML = `<span class="num">${g.year}</span><span class="line"></span>`;
        block.appendChild(row);
        // attach the block (and its year-row) to the live document now,
        // before any tile-grid inside it needs to measure its width
        grid.appendChild(block);

        for (const m of g.months) {
          if (m.month) {
            const label = document.createElement("p");
            label.className = "month-label";
            const idx = parseInt(m.month, 10) - 1;
            label.textContent = MONTHS[idx] ?? m.month;
            block.appendChild(label);
          }
          const tileGrid = document.createElement("div");
          tileGrid.className = "tile-grid";
          block.appendChild(tileGrid);
          buildTileGrid(tileGrid, m.items);
        }
      }
      // justified rows fills strictly in `filtered`'s own order (row by
      // row, left to right, group by group) — DOM order already matches
      // on-screen reading order, so no separate bookkeeping is needed
      // for lightbox arrow-key/swipe nav here
      visiblePhotos = filtered;
    }
  }

  const lightbox = document.getElementById("lightbox")!;
  const lightboxImage = document.getElementById("lightbox-image")!;
  const lightboxLocation = document.getElementById("lightbox-location")!;
  const lightboxMeta = document.getElementById("lightbox-meta")!;
  const lightboxNotes = document.getElementById("lightbox-notes")!;
  const lightboxClose = document.getElementById("lightbox-close")!;

  // stop the page behind the lightbox from scrolling — otherwise a touch
  // drag meant as a left/right swipe between photos also drags the page
  // up/down underneath, which is what made swiping feel clunky
  function lockBodyScroll() {
    document.documentElement.style.overflow = "hidden";
    document.body.style.overflow = "hidden";
  }
  function unlockBodyScroll() {
    document.documentElement.style.overflow = "";
    document.body.style.overflow = "";
  }

  function openLightbox(photo: Photo) {
    currentIndex = visiblePhotos.findIndex((p) => p.id === photo.id);
    lockBodyScroll();

    lightboxImage.innerHTML = "";
    if (photo.image) {
      lightboxImage.classList.remove("color-fallback");
      lightboxImage.style.background = "";
      const img = document.createElement("img");
      img.src = photo.image;
      img.alt = "";
      lightboxImage.appendChild(img);
    } else {
      lightboxImage.classList.add("color-fallback");
      lightboxImage.style.background = photo.color ?? "";
    }
    lightboxLocation.textContent = photo.location;
    lightboxMeta.textContent = [formatDate(photo.date), photo.camera, photo.film]
      .filter(Boolean)
      .join(" · ");
    lightboxNotes.textContent = photo.notes || "";
    lightbox.hidden = false;
  }

  // steps to another photo in the currently visible (filtered/sorted) set,
  // wrapping around at either end
  function showPhotoAt(index: number) {
    if (visiblePhotos.length === 0) return;
    const wrapped = ((index % visiblePhotos.length) + visiblePhotos.length) % visiblePhotos.length;
    openLightbox(visiblePhotos[wrapped]);
  }

  function closeLightbox() {
    lightbox.hidden = true;
    unlockBodyScroll();
  }

  lightboxClose.addEventListener("click", closeLightbox);
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (lightbox.hidden) return;
    if (e.key === "Escape") {
      closeLightbox();
    } else if (e.key === "ArrowLeft") {
      e.preventDefault();
      showPhotoAt(currentIndex - 1);
    } else if (e.key === "ArrowRight") {
      e.preventDefault();
      showPhotoAt(currentIndex + 1);
    }
  });

  // swipe left/right to move between photos on touch devices
  const SWIPE_THRESHOLD = 50; // px — below this it's a tap or a scroll, not a swipe
  let touchStartX = 0;
  let touchStartY = 0;

  lightbox.addEventListener(
    "touchstart",
    (e) => {
      const t = e.changedTouches[0];
      touchStartX = t.clientX;
      touchStartY = t.clientY;
    },
    { passive: true }
  );

  lightbox.addEventListener(
    "touchend",
    (e) => {
      const t = e.changedTouches[0];
      const dx = t.clientX - touchStartX;
      const dy = t.clientY - touchStartY;
      if (Math.abs(dx) < SWIPE_THRESHOLD || Math.abs(dx) < Math.abs(dy) * 1.5) return;
      if (dx < 0) {
        showPhotoAt(currentIndex + 1); // swiped left → next photo
      } else {
        showPhotoAt(currentIndex - 1); // swiped right → previous photo
      }
    },
    { passive: true }
  );

  sortOldestBtn.addEventListener("click", () => {
    sortDir = "oldest";
    sortOldestBtn.classList.add("active");
    sortNewestBtn.classList.remove("active");
    shuffleBtn.classList.remove("active");
    shuffleBtn.title = "Shuffle";
    shuffleBtn.setAttribute("aria-label", "Shuffle");
    render();
  });
  sortNewestBtn.addEventListener("click", () => {
    sortDir = "newest";
    sortNewestBtn.classList.add("active");
    sortOldestBtn.classList.remove("active");
    shuffleBtn.classList.remove("active");
    shuffleBtn.title = "Shuffle";
    shuffleBtn.setAttribute("aria-label", "Shuffle");
    render();
  });
  let shuffleFlashTimer: ReturnType<typeof setTimeout> | undefined;

  shuffleBtn.addEventListener("click", () => {
    // re-shuffles even if already shuffled — every click is a fresh
    // random order, not just a one-time toggle
    sortDir = "shuffle";
    shuffleBtn.classList.add("active");
    sortOldestBtn.classList.remove("active");
    sortNewestBtn.classList.remove("active");
    // once you're already shuffled, the button's own job changes from
    // "turn shuffle on" to "shuffle again" — say so
    shuffleBtn.title = "Shuffle again";
    shuffleBtn.setAttribute("aria-label", "Shuffle again");
    render();

    // restart the spin even on back-to-back clicks: remove the class,
    // force a reflow so the browser forgets the animation ran, then add
    // it back
    shuffleBtn.classList.remove("spin");
    void shuffleBtn.offsetWidth;
    shuffleBtn.classList.add("spin");

    // momentary click feedback: flash the accent color immediately, then
    // fade back (via the site-wide color transition) after 2s. Restart
    // the same way as the spin above so back-to-back clicks each get
    // their own full 2s, rather than the first click's timer cutting a
    // later flash short.
    clearTimeout(shuffleFlashTimer);
    shuffleBtn.classList.remove("flash");
    void shuffleBtn.offsetWidth;
    shuffleBtn.classList.add("flash");
    shuffleFlashTimer = setTimeout(() => shuffleBtn.classList.remove("flash"), 2000);
  });

  // filtering/sorting (not layout — that's pure CSS now, see .tile-grid
  // above) still has to build the initial grid here in JS rather than
  // server-side, since sort/shuffle state lives client-side.
  render();

  // No resize listener needed anymore: row height is a CSS container
  // query off the grid's own width (see .tile-grid above), so the
  // browser restyles it automatically on any resize — including the
  // mobile-address-bar-collapsing kind that used to force a full
  // render() rebuild and rubber-band the page back to the top mid-scroll.
</script>
